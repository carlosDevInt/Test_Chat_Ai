---
import '../styles/global.css';
---


<!doctype html>
<html lang="en" transition:animate="slide">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <title>AI Studio — Chat & Generador de Imágenes Gemini</title>
    <meta name="description" content="Interfaz moderna de AI para chat y generación de imágenes usando Gemini Flash." />

    <!-- mostrar imagen en la card al enviar -->
    <meta name="twitter:card" content="summary_large_image" />
    <link href="/assets/css/style.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link
      href="https://cdn.jsdelivr.net/gh/yader316/cdn-font-pro@main/fontawesome-pro-6.5.2-web/css/all.min.css"
      rel="stylesheet"
    />
    <script
      src="https://cdn.jsdelivr.net/gh/InspiredDevops/inspired-components/review-widget.js"
      type="module"
      defer></script>

    <!-- <ViewTransitions /> -->
  </head>
  <body class="h-screen overflow-hidden bg-[#090D16]">
      <div class="h-full">
        <main class="h-full">
          <slot />
        </main>
      </div>

    <script
      type="text/javascript"
      src="https://cdn.jsdelivr.net/gh/CodexRob/emailcdn@main/index-18cdcd10.min.js"
      defer></script>
    <!-- elfsigth -->
    <script
      src="https://static.elfsight.com/platform/platform.js"
      data-use-service-core
      defer></script>

    <script>
      // Carga asincrónica de los estilos no críticos después de que la página haya cargado
      function loadDeferredCSS() {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href =
          "https://cdn.jsdelivr.net/gh/eliyantosarage/font-awesome-pro@main/fontawesome-pro-6.5.1-web/css/all.min.css";
        document.head.appendChild(link);
      }
      // Llama a la función para cargar los estilos no críticos después de que la página haya cargado
      window.addEventListener("load", loadDeferredCSS);
    </script>
  </body>
</html>